<script>
// --- RATING SYSTEM ---
let ratings = JSON.parse(localStorage.getItem('worknear_ratings') || '{}'); // jobId -> [ratings]

function rateUser(jobId, phone, name){
  let r = prompt(`Rate ${name} - Job ${jobId}\n\nEnter 1 to 5 stars:\n5 = Excellent, honest, on time\n4 = Good\n3 = Okay\n2 = Bad\n1 = Dishonest / Fake\n\nSupport: 0779757160 to report fraud`);
  if(!r) return;
  r = parseInt(r);
  if(r<1 || r>5){ alert("Enter 1-5"); return; }
  
  if(!ratings[jobId]) ratings[jobId] = [];
  ratings[jobId].push(r);
  localStorage.setItem('worknear_ratings', JSON.stringify(ratings));
  
  let avg = (ratings[jobId].reduce((a,b)=>a+b,0) / ratings[jobId].length).toFixed(1);
  
  // Update carrier rating if it's a carrier
  let carrier = carriers.find(c=>c.id==jobId || c.phone==phone);
  if(carrier){
    carrier.rating = parseFloat(avg);
    carrier.jobsDone = ratings[jobId].length;
    localStorage.setItem('worknear_carriers', JSON.stringify(carriers));
  }
  
  alert(`Thanks! You rated ${name} ${r} stars. Average now ${avg} stars`);
  render(); renderCarriers();
}

function getStars(jobId){
  let arr = ratings[jobId] || [];
  if(arr.length==0) return {avg: 5.0, count: 0, stars: "⭐⭐⭐⭐⭐ (New)"};
  let avg = arr.reduce((a,b)=>a+b,0)/arr.length;
  let full = Math.round(avg);
  let stars = "⭐".repeat(full) + "☆".repeat(5-full);
  return {avg: avg.toFixed(1), count: arr.length, stars: `${stars} ${avg.toFixed(1)} (${arr.length})`};
}

function reportUser(phone, name){
  if(confirm(`Report ${name} for dishonest behaviour?\n\nThis will be sent to WorkNear Support 0779757160 for investigation.\n\nContinue?`)){
    let reason = prompt("What happened? e.g. Took money, didn't come, fake lorry");
    if(!reason) return;
    let msg = `REPORT DISHONEST USER\nName: ${name}\nPhone: ${phone}\nReason: ${reason}\nReporter: ${currentUser?.phone}\nPlease check and block if fake`;
    window.open(`https://wa.me/263779757160?text=${encodeURIComponent(msg)}`, "_blank");
  }
}

// --- UPDATED RENDER WITH RATING ---
function render(){
 let selCountry=document.getElementById('countrySelect').value;
 let selCity=document.getElementById('cityInput').value.toLowerCase();
 let list=document.getElementById('jobsList');
 let html=""; let count=0;
 jobs.slice().reverse().forEach(job=>{
  if(job.country!==selCountry) return;
  if(selCity.length>2 && !job.city.toLowerCase().includes(selCity) && !job.area.toLowerCase().includes(selCity)) return;
  let dist=haversine(userLoc.lat,userLoc.lon,job.lat,job.lon);
  if(dist>maxDist) return;
  count++;
  let unlocked=unlockedJobs[job.id];
  let free=checkFreeStatus();
  let rating = getStars(job.id);
  
  let btn = (unlocked||free) ? 
  `<button class="wa" onclick="openWhatsAppDirect('${job.phone}','${job.title}')">💬 WhatsApp DIRECT</button>
   <p style="font-size:11px">📞 ${job.phone} • ${free?'(FREE)':'(10 ZiG paid)'}</p>
   <div style="display:flex;gap:4px;margin-top:6px">
     <button onclick="rateUser(${job.id},'${job.phone}','${job.title}')" style="background:#fff;border:1px solid #ddd;padding:6px;font-size:11px">⭐ Rate</button>
     <button onclick="reportUser('${job.phone}','${job.title}')" style="background:#fff;border:1px solid #ff4444;color:#ff4444;padding:6px;font-size:11px">🚩 Report</button>
   </div>` :
  `<button class="gold" onclick="payToUnlock('${job.phone}','${job.title}',${job.id})">🔓 Pay 10 ZiG to Unlock</button>
   <small>Rating: ${rating.stars} • Help 0779757160</small>`;

  html+=`<div class="job-card" style="${rating.avg < 2.5 ? 'opacity:0.6;border:1px dashed #ff4444' : ''}">
   <div style="display:flex;justify-content:space-between;font-size:11px">
     <span class="badge">${job.type}</span>
     <span>${dist.toFixed(1)}km</span>
   </div>
   <h3 style="margin:6px 0">${job.title} ${rating.count>0 ? `<span style="font-size:11px">${rating.stars}</span>` : ''}</h3>
   <div style="font-size:12px">💰 ${job.pay} • ⏰ ${job.time} • ${rating.stars}</div>
   <small>📍 ${job.area}, ${job.city}</small>
   ${rating.avg < 2 ? '<div style="background:#ff4444;color:#fff;font-size:10px;padding:2px 6px;border-radius:10px;margin-top:4px;display:inline-block">⚠️ Low Rating - Use Caution</div>' : ''}
   <div style="display:flex;gap:6px;margin-top:8px">
     <button id="t-${job.id}" onclick="toggleTimer(${job.id})" style="flex:1">START</button>
     <div style="flex:2">${btn}</div>
   </div>
   <small id="time-${job.id}">Worked: 0m 0s</small>
  </div>`;
 });
 document.getElementById('countLabel').innerText=count+" jobs within "+maxDist+"km";
 list.innerHTML=html||`<div class="job-card">No jobs within ${maxDist}km</div>`;
}

function renderCarriers(){
 let list=document.getElementById('carrierList');
 let html="";
 carriers.slice().reverse().forEach(car=>{
  let r = getStars(car.id);
  let isBad = r.avg < 2.5 && r.count >=3;
  html+=`<div class="job-card" style="${car.verified?'border-left:5px solid #00a651':''} ${isBad?'border:2px solid #ff4444':''}">
   <div style="display:flex;justify-content:space-between">
     <b>${car.type} - ${car.lorryReg}</b>
     ${car.verified?'<span style="background:#00a651;color:#fff;padding:3px 8px;border-radius:10px;font-size:11px">✓ VERIFIED</span>':'<span style="background:#ff9800;color:#fff;padding:3px 8px;border-radius:10px;font-size:11px">⏳ UNVERIFIED</span>'}
   </div>
   <p style="font-size:12px">${car.name} • ${r.stars} • ${car.jobsDone} jobs</p>
   <small>ID: ${car.idNumber.slice(0,4)}**** • ${car.hasID&&car.hasLicense&&car.hasLorry?'Docs OK':'Docs missing'}</small><br>
   ${isBad ? '<small style="color:red">⚠️ Low rating - Reported multiple times</small><br>' : ''}
   <button class="${car.verified?'wa':'gold'}" onclick="payToUnlock('${car.phone}','Lorry ${car.lorryReg}',${car.id})">${car.verified?'💬 WhatsApp Verified DIRECT':'🔓 Unlock 10 ZiG'}</button>
   <div style="display:flex;gap:4px;margin-top:6px">
     <button onclick="rateUser(${car.id},'${car.phone}','${car.name}')" style="background:#fff;border:1px solid #ddd;padding:6px;font-size:11px;flex:1">⭐ Rate ${car.name}</button>
     <button onclick="reportUser('${car.phone}','${car.name}')" style="background:#fff;border:1px solid #ff4444;color:#ff4444;padding:6px;font-size:11px;flex:1">🚩 Report Fraud</button>
   </div>
  </div>`;
 });
 list.innerHTML=html;
}
</script><!DOCTYPE html>
<html>
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>WorkNear Admin - Only You</title>
<style>
body{font-family:Arial;margin:0;background:#111;color:#fff;padding:10px}
